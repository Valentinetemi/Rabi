# Copy to .env and fill in. .env is gitignored; never commit it.

# Where the MCP server listens. Keep 127.0.0.1 unless you expose it via a tunnel.
RABI_HOST=127.0.0.1
RABI_PORT=8000

# Shared secret for remote clients (Alexa+ via ngrok). Required whenever
# RABI_HOST is not localhost. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
RABI_AUTH_TOKEN=

# Amazon Bedrock (used to turn raw diagnostics into friendly spoken answers).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# AWS credentials: prefer `aws configure` / AWS_PROFILE; or set keys here.
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
