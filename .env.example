# Copy to .env and fill in. .env is gitignored; never commit it.

# Where the MCP server listens. Keep 127.0.0.1 unless you expose it via a tunnel.
RABI_HOST=127.0.0.1
RABI_PORT=8000

# Shared secret for remote clients (Alexa+ via ngrok). Required whenever
# RABI_HOST is not localhost. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
RABI_AUTH_TOKEN=

# Public hostname(s) of your tunnel, comma separated, e.g. abc123.ngrok-free.app.
# Setting this turns auth on and lets the tunnel's Host header through.
RABI_PUBLIC_HOSTS=

# Folders unpushed_work scans for git repos, separated by ":".
RABI_PROJECT_ROOTS=~/dev

# Optional: journey file for my_journey (default data/journey.json, then the example).
# RABI_JOURNEY_FILE=

# Amazon Bedrock (used to turn raw diagnostics into friendly spoken answers).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# AWS credentials: prefer `aws configure` / AWS_PROFILE; or set keys here.
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
